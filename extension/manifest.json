{
  "manifest_version": 3,
  "name": "EraseAI Firewall: Block Secrets & PII Before ChatGPT, Claude, Gemini",
  "short_name": "EraseAI Firewall",
  "version": "1.6.0",
  "description": "Stops API keys, passwords, card numbers and personal data before they reach ChatGPT, Claude or Gemini, in prompts and files.",
  "author": "Vantward Solutions Pte. Ltd.",
  "homepage_url": "https://eraseai.ai/ai-firewall",
  "minimum_chrome_version": "88",
  "key": "",
  "permissions": ["storage", "activeTab"],
  "storage": {
    "managed_schema": "managed_schema.json"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://replit.com/*"
      ],
      "js": ["src/concurrency-config.js", "src/limits-config.js", "src/file-extractor.js", "src/content.js"],
      "css": ["src/overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://chat.openai.com/*",
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://replit.com/*",
    "https://eraseai.ai/*"
  ],
  "sandbox": {
    "pages": ["src/sandbox.html"]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/sandbox.html",
        "src/sandbox.js",
        "src/sandbox-extractor.js",
        "vendor/tesseract/worker.min.js",
        "vendor/tesseract/tesseract-core-simd-lstm.wasm.js",
        "vendor/tesseract/tesseract-core-lstm.wasm.js",
        "vendor/tesseract/eng.traineddata.gz"
      ],
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://replit.com/*"
      ]
    }
  ]
}
