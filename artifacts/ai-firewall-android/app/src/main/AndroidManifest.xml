<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <uses-permission android:name="android.permission.INTERNET" />

  <queries>
    <package android:name="com.openai.chatgpt" />
    <package android:name="com.anthropic.claude" />
    <package android:name="com.google.android.apps.bard" />
    <package android:name="com.google.android.googlequicksearchbox" />
    <package android:name="ai.deepseek" />
    <package android:name="com.replit.app" />
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent>
  </queries>

  <application
    android:allowBackup="true"
    android:icon="@drawable/eraseai_logo"
    android:label="@string/app_name"
    android:roundIcon="@drawable/eraseai_logo"
    android:supportsRtl="true"
    android:theme="@style/Theme.EraseAIFirewall">

    <activity
      android:name=".MainActivity"
      android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />

        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.SEND" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="text/plain" />
      </intent-filter>
    </activity>

    <service
      android:name=".guard.AiGuardAccessibilityService"
      android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
      android:exported="false">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>

      <meta-data
        android:name="android.accessibilityservice"
        android:resource="@xml/accessibility_service_config" />
    </service>
  </application>

</manifest>
