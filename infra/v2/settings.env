# v2 replica settings, read by .github/workflows/aws-v2.yml on every push.
# MODE=running  deploy and test the replica (about US$5/day)
# MODE=paused   nothing runs; load balancer, WAF and NAT are removed (cheapest)
MODE=paused
# Attach aws.eraseai.ai to the v2 website once the old (v1) Amplify app has
# released it; until then the site answers on its amplifyapp.com address.
ATTACH_DOMAIN=false
